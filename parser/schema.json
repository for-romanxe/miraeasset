{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "연금 상품 메타 스키마 (투자설명서 파싱 산출물)",
  "description": "과제소개자료 5p의 상품 6축(상품분류·위험등급·판매클래스·총보수·수익률·시장잔고)을 검색 가능한 정형 필드로 표현한다. 모든 값에는 근거 페이지가 붙는다.",
  "type": "object",
  "required": ["isin", "fund_name", "source"],
  "properties": {
    "isin": {
      "type": "string",
      "description": "표준코드. 폴더명에서 취득. 레코드 기본키",
      "examples": ["KR510902511M"]
    },
    "fund_name": {
      "type": "string",
      "description": "집합투자기구 명칭",
      "examples": ["미래에셋장기성장포커스증권자투자신탁1호(주식)"]
    },
    "asset_manager": {
      "type": ["string", "null"],
      "description": "집합투자업자(운용사) 명칭"
    },
    "base_date": {
      "type": ["string", "null"],
      "format": "date",
      "description": "투자설명서 작성기준일. 상품 정보의 유효시점이므로 답변에 반드시 병기"
    },

    "risk_grade": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 6,
      "description": "[6축-위험등급] 1=매우 높은 위험 ~ 6=매우 낮은 위험. 숫자여야 부등호 필터가 걸린다"
    },
    "risk_label": {
      "type": ["string", "null"],
      "description": "위험등급 한글 라벨",
      "examples": ["매우 높은 위험", "낮은 위험"]
    },

    "asset_type": {
      "type": ["string", "null"],
      "description": "[6축-상품분류] 투자설명서 '분류' 행의 증권 유형 원문",
      "examples": ["주식형", "채권형", "주식혼합-재간접형", "혼합채권형"]
    },
    "asset_type_group": {
      "type": ["string", "null"],
      "enum": ["주식형", "채권형", "혼합형", "재간접형", "파생형", "기타", null],
      "description": "[6축-상품분류] 위 원문을 검색용으로 정규화한 대분류"
    },
    "structure": {
      "type": "array",
      "items": { "type": "string" },
      "description": "펀드 구조 태그. 개방형/추가형/모자형/종류형/전환형/단위형 등",
      "examples": [["투자신탁", "개방형", "추가형", "모자형", "종류형"]]
    },

    "classes": {
      "type": "array",
      "description": "[6축-판매클래스, 총보수] 클래스별 비용. 연금계좌 매수 가능 여부 판정의 근거",
      "items": {
        "type": "object",
        "properties": {
          "code": { "type": ["string", "null"], "description": "클래스 코드", "examples": ["A", "C1", "A-e", "C-P", "C-P2"] },
          "name": { "type": "string", "description": "클래스 전체 명칭 원문" },
          "front_load": { "type": ["string", "null"], "description": "선취판매수수료 원문 (미징구면 null)" },
          "total_fee": { "type": ["number", "null"], "description": "총보수 연 %. 상품 비교의 핵심 축" },
          "sales_fee": { "type": ["number", "null"], "description": "판매보수 연 %" },
          "peer_total_fee": { "type": ["number", "null"], "description": "동종유형 평균 총보수 연 %. 비싼지 싼지 판단 기준" },
          "total_cost_ratio": { "type": ["number", "null"], "description": "총보수·비용 비율 연 %" },
          "cost_example": {
            "type": "object",
            "description": "1,000만원 투자 시 기간별 총비용 예시 (천원)",
            "properties": {
              "y1": { "type": ["number", "null"] }, "y2": { "type": ["number", "null"] },
              "y3": { "type": ["number", "null"] }, "y5": { "type": ["number", "null"] },
              "y10": { "type": ["number", "null"] }
            }
          },
          "is_pension": { "type": "boolean", "description": "퇴직연금 전용 클래스 여부 (C-P2 계열). true여야 DC/IRP 계좌에서 매수 가능" },
          "is_personal_pension": { "type": "boolean", "description": "개인연금 전용 클래스 여부 (C-P 계열)" },
          "is_online": { "type": "boolean", "description": "온라인 전용 클래스 여부 (-e 계열). 통상 보수가 더 낮다" }
        },
        "required": ["name"]
      }
    },
    "has_pension_class": {
      "type": "boolean",
      "description": "퇴직연금(C-P2) 또는 개인연금(C-P) 클래스 보유 여부. 연금계좌 추천 가능 상품 1차 필터"
    },
    "min_total_fee": {
      "type": ["number", "null"],
      "description": "전 클래스 중 최저 총보수. 상품 간 보수 비교·정렬용 대표값"
    },
    "pension_total_fee": {
      "type": ["number", "null"],
      "description": "퇴직연금 클래스의 총보수. 연금 문맥에서 실제로 적용되는 보수"
    },

    "returns": {
      "type": "object",
      "description": "[6축-수익률] 연평균 수익률(%). 투자설명서 요약정보의 투자실적 추이 표, 펀드 본체 행 기준",
      "properties": {
        "y1": { "type": ["number", "null"] },
        "y2": { "type": ["number", "null"] },
        "y3": { "type": ["number", "null"] },
        "y5": { "type": ["number", "null"] },
        "since_inception": { "type": ["number", "null"] }
      }
    },

    "aum": {
      "type": ["number", "null"],
      "description": "[6축-시장잔고] 최근 결산기 자본총계(순자산총액), 단위 백만원"
    },
    "aum_unit": { "type": ["string", "null"], "description": "원문 표기 단위", "examples": ["백만원"] },
    "aum_period": { "type": ["string", "null"], "description": "해당 결산기 표기", "examples": ["14기(24.12.22)"] },
    "is_small_fund": {
      "type": ["boolean", "null"],
      "description": "소규모 집합투자기구 해당 가능성 (자본총계 50억원=5,000백만원 미만). 임의해지 위험 고지 대상"
    },

    "page_count": { "type": "integer", "description": "PDF 총 페이지 수" },
    "source": {
      "type": "object",
      "description": "근거 표시용. 모든 답변에 근거 문서를 표시하라는 평가 요건 대응",
      "properties": {
        "file": { "type": "string", "description": "레포 기준 상대 경로" },
        "summary_page": { "type": ["integer", "null"], "description": "요약정보 페이지 (1-based). 분류·위험등급·보수·수익률의 근거" },
        "aum_page": { "type": ["integer", "null"], "description": "요약재무정보 페이지 (1-based). 시장잔고의 근거" }
      }
    },
    "parse_warnings": {
      "type": "array",
      "items": { "type": "string" },
      "description": "추출 실패·불확실 필드 기록. 값이 있으면 Agent가 단정 답변 대신 한계 고지에 사용"
    }
  }
}
